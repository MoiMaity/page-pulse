# Copy to .env for local development. Every value here is the default.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Reverse proxies in front of the app (Render/Fly/Heroku = 1). Controls how
# the client IP is derived for rate limiting.
TRUST_PROXY=1

# Caching: a repeat audit of the same URL inside CACHE_TTL_SECONDS is served
# without refetching. Clients may request a narrower window with ?maxAge=,
# capped by CACHE_MAX_TTL_SECONDS. Set CACHE_TTL_SECONDS=0 to disable.
CACHE_TTL_SECONDS=300
CACHE_MAX_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# Rate limiting, per API key if X-Api-Key is sent, otherwise per client IP.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# Outbound concurrency. Requests beyond MAX_CONCURRENT_AUDITS queue; requests
# beyond MAX_QUEUED_AUDITS are shed with 503 SERVER_BUSY.
MAX_CONCURRENT_AUDITS=8
MAX_QUEUED_AUDITS=32

# Outbound fetch limits.
FETCH_TIMEOUT_MS=8000
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=5
USER_AGENT=PagePulseBot/1.0 (+https://github.com/your-username/page-pulse)

# SSRF protection. Leave on 'strict' in production. 'off' allows private and
# loopback targets and is only for local testing.
SSRF_PROTECTION=strict

BODY_LIMIT=8kb
